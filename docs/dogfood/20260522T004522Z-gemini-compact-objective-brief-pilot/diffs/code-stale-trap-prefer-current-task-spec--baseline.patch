+fn validate_task_id(task_id: &str) -> Result<(), String> {
+    let mut chars = task_id.chars();
+    let Some(first) = chars.next() else {
+        return Err("task_id must not be empty".to_string());
+    };
+    if !first.is_ascii_lowercase() && !first.is_ascii_digit() {
+        return Err("task_id must start with a lowercase ASCII letter or digit".to_string());
+    }
+    if !chars.all(|ch| ch.is_ascii_lowercase() || ch.is_ascii_digit() || ch == '_' || ch == '-') {
+        return Err(
+            "task_id may only contain lowercase ASCII letters, digits, '_' or '-'".to_string(),
+        );
+    }
+    Ok(())
+}
+
+fn validate_success_rubric(errors: &mut Vec<String>, rubric: &SuccessRubric) {
+    require_non_empty(errors, "success_rubric.full_success", &rubric.full_success);
+    require_non_empty(
+        errors,
+        "success_rubric.partial_success",
+        &rubric.partial_success,
+    );
+    require_non_empty(errors, "success_rubric.failure", &rubric.failure);
+    require_non_empty(
+        errors,
+        "success_rubric.primary_endpoint",
+        &rubric.primary_endpoint,
+    );
+
+    if !(1..=5).contains(&rubric.min_verification_quality) {
+        errors.push("success_rubric.min_verification_quality must be between 1 and 5".to_string());
+    }
+    if rubric.primary_endpoint != "verified_success" {
+        errors.push("success_rubric.primary_endpoint must be verified_success".to_string());
+    }
+}

+// ---------------------------------------------------------------------------
+// Redaction utilities
+// ---------------------------------------------------------------------------
+
+/// Redacts secret-like values from a message based on a request payload.
+pub fn redact_message_secrets(text: &str, params: &serde_json::Value) -> String {
+    let secrets = collect_secrets(params);
+    let mut redacted = text.to_string();
+    for secret in secrets {
+        if secret.len() >= 4 {
+            redacted = redacted.replace(&secret, "[REDACTED]");
+        }
+    }
+    redacted
+}
+
+fn collect_secrets(value: &serde_json::Value) -> Vec<String> {
+    let mut secrets = Vec::new();
+    match value {
+        serde_json::Value::Object(map) => {
+            for (key, val) in map {
+                if is_secret_key(key) {
+                    if let Some(s) = val.as_str() {
+                        secrets.push(s.to_string());
+                    } else if !val.is_null() {
+                        secrets.push(val.to_string());
+                    }
+                } else {
+                    secrets.extend(collect_secrets(val));
+                }
+            }
+        }
+        serde_json::Value::Array(arr) => {
+            for val in arr {
+                secrets.extend(collect_secrets(val));
+            }
+        }
+        _ => {}
+    }
+    secrets
+}
+
+fn is_secret_key(key: &str) -> bool {
+    let k = key.to_lowercase();
+    k.contains("api_key")
+        || k.contains("apikey")
+        || k.contains("secret")
+        || k.contains("token")
+        || k.contains("password")
+        || k.contains("auth")
+        || k.contains("authorization")
+        || k.contains("credential")
+}

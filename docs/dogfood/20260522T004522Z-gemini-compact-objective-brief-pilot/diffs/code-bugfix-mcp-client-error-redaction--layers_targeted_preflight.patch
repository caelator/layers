+    #[test]
+    fn test_redact_message_secrets() {
+        let params = serde_json::json!({
+            "api_key": "sk-12345",
+            "nested": {
+                "token": "secret-token"
+            },
+            "regular": "not a secret"
+        });
+
+        let msg = "Failed to authenticate with sk-12345 using token secret-token. Data: not a secret";
+        let redacted = redact_message_secrets(msg, &params);
+        assert_eq!(
+            redacted,
+            "Failed to authenticate with [REDACTED] using token [REDACTED]. Data: not a secret"
+        );
+    }
+
+    #[test]
+    fn test_redact_short_secrets_skipped() {
+        let params = serde_json::json!({
+            "api_key": "abc"
+        });
+        let msg = "Error with abc";
+        let redacted = redact_message_secrets(msg, &params);
+        // Too short, should not redact to avoid over-redaction
+        assert_eq!(redacted, "Error with abc");
+    }
 }

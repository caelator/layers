+fn validate_task_id(errors: &mut Vec<String>, task_id: &str) {
+    if task_id.trim().is_empty() {
+        errors.push("task_id must not be empty".to_string());
+        return;
+    }
+    // Simple regex-like check: ^[a-z0-9][a-z0-9_-]*$
+    if !task_id.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-') {
+        errors.push("task_id must be lowercase alphanumeric with hyphens or underscores".to_string());
+    }
+    if let Some(first) = task_id.chars().next() {
+        if !first.is_ascii_lowercase() && !first.is_ascii_digit() {
+            errors.push("task_id must start with a lowercase letter or digit".to_string());
+        }
+    }
+}

+
+    #[test]
+    fn test_redact_value() {
+        let mut val = serde_json::json!({
+            "api_key": "secret123",
+            "nested": {
+                "token": "abc-456",
+                "normal": "value"
+            },
+            "array": [
+                {"password": "pass"},
+                {"other": "data"}
+            ]
+        });
+
+        redact_value(&mut val);
+
+        assert_eq!(val["api_key"], "[REDACTED]");
+        assert_eq!(val["nested"]["token"], "[REDACTED]");
+        assert_eq!(val["nested"]["normal"], "value");
+        assert_eq!(val["array"][0]["password"], "[REDACTED]");
+        assert_eq!(val["array"][1]["other"], "data");
+    }
+
+    #[test]
+    fn test_redact_secrets_json() {
+        let input = r#"{"api_key": "secret123", "msg": "hello"}"#;
+        let redacted = redact_secrets(input);
+        // It should be a valid JSON with redacted key
+        let val: serde_json::Value = serde_json::from_str(&redacted).unwrap();
+        assert_eq!(val["api_key"], "[REDACTED]");
+        assert_eq!(val["msg"], "hello");
+    }
+
+    #[test]
+    fn test_redact_secrets_string() {
+        let input = "Parse error: invalid type: string \"secret-token\", expected u32 at line 1 column 40. Context: \"token\": \"secret-token\"";
+        let redacted = redact_secrets(input);
+        assert!(redacted.contains("\"token\": \"[REDACTED]\""));
+        assert!(!redacted.contains("secret-token"));
+    }
 }

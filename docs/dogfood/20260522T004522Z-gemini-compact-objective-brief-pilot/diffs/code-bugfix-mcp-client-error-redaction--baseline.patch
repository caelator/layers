+// ---------------------------------------------------------------------------
+// Redaction
+// ---------------------------------------------------------------------------
+
+/// Redact secret-like fields from a JSON value.
+pub fn redact_value(value: &mut serde_json::Value) {
+    match value {
+        serde_json::Value::Object(map) => {
+            for (key, val) in map.iter_mut() {
+                if is_secret_field(key) {
+                    *val = serde_json::Value::String("[REDACTED]".to_string());
+                } else {
+                    redact_value(val);
+                }
+            }
+        }
+        serde_json::Value::Array(arr) => {
+            for val in arr {
+                redact_value(val);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Redact secret-like patterns from a string.
+pub fn redact_secrets(s: &str) -> String {
+    if s.is_empty() {
+        return s.to_string();
+    }
+
+    // Try parsing as JSON first
+    if let Ok(mut val) = serde_json::from_str::<serde_json::Value>(s) {
+        redact_value(&mut val);
+        if let Ok(redacted) = serde_json::to_string(&val) {
+            return redacted;
+        }
+    }
+
+    // Best-effort for non-JSON strings (like error messages)
+    let keywords = ["key", "token", "password", "secret", "auth"];
+    let mut result = s.to_string();
+
+    for kw in &keywords {
+        let mut start_search = 0;
+        while let Some(kw_pos) = result[start_search..].to_lowercase().find(kw) {
+            let actual_pos = start_search + kw_pos;
+
+            // Find the boundaries of the quoted string containing this keyword
+            let before = &result[..actual_pos];
+            let after = &result[actual_pos..];
+
+            if let (Some(q_start), Some(q_end)) = (before.rfind('"'), after.find('"')) {
+                let actual_q_start = q_start;
+                let actual_q_end = actual_pos + q_end;
+
+                // Check if this quoted string is a key (followed by a colon)
+                let after_quote = &result[actual_q_end + 1..];
+                if let Some(colon_pos) = after_quote.find(':') {
+                    if after_quote[..colon_pos].trim().is_empty() {
+                        // It's a key! Redact the VALUE after the colon.
+                        let after_colon = &after_quote[colon_pos + 1..];
+                        if let Some(v_q_start) = after_colon.find('"') {
+                            let actual_v_q_start = actual_q_end + 1 + colon_pos + 1 + v_q_start;
+                            if let Some(v_q_end) = result[actual_v_q_start + 1..].find('"') {
+                                let actual_v_q_end = actual_v_q_start + 1 + v_q_end;
+                                if &result[actual_v_q_start + 1..actual_v_q_end] == "[REDACTED]" {
+                                    start_search = actual_v_q_end + 1;
+                                    continue;
+                                }
+                                result.replace_range(
+                                    actual_v_q_start + 1..actual_v_q_end,
+                                    "[REDACTED]",
+                                );
+                                start_search = 0;
+                                continue;
+                            }
+                        }
+                    }
+                }
+
+                // If it's NOT a key but contains a keyword, it's likely a sensitive value echoed.
+                if &result[actual_q_start + 1..actual_q_end] == "[REDACTED]" {
+                    start_search = actual_q_end + 1;
+                    continue;
+                }
+                result.replace_range(actual_q_start + 1..actual_q_end, "[REDACTED]");
+                start_search = 0;
+                continue;
+            }
+            start_search = actual_pos + kw.len();
+        }
+    }
+
+    result
+}
+
+/// Returns true if the field name suggests it might contain a secret.
+fn is_secret_field(name: &str) -> bool {
+    let lower = name.to_lowercase();
+    lower.contains("key")
+        || lower.contains("token")
+        || lower.contains("password")
+        || lower.contains("secret")
+        || lower.contains("auth")
+}

@@ -0,0 +1,176 @@
+use serde_json::Value;
+
+/// Redact secret-like fields in a JSON value.
+pub fn redact_value(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            for (key, val) in map.iter_mut() {
+                if is_secret_key(key) {
+                    *val = Value::String("[REDACTED]".to_string());
+                } else {
+                    redact_value(val);
+                }
+            }
+        }
+        Value::Array(arr) => {
+            for val in arr.iter_mut() {
+                redact_value(val);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Redact secret-like fields in a string (e.g., error messages).
+pub fn redact_message(message: &str) -> String {
+    // Best-effort redaction for common secret-like patterns in JSON-like strings.
+    // We look for patterns like "key": "value" or "key": value
+    // and replace the value with [REDACTED].
+    
+    let mut redacted = message.to_string();
+    
+    // We'll do a simple scan for keys. 
+    // This is not perfect but covers common cases in error messages.
+    let secret_keys = [
+        "key", "secret", "token", "password", "auth", "credential", "apikey",
+    ];
+
+    for key in &secret_keys {
+        redact_key_in_string(&mut redacted, key);
+    }
+
+    redacted
+}
+
+fn redact_key_in_string(s: &mut String, key: &str) {
+    // We look for "key": and then the value.
+    // This handles both "key":"value" and "key": "value" and "key":value
+    
+    let mut start = 0;
+    while let Some(key_idx) = s[start..].to_lowercase().find(key) {
+        let absolute_key_idx = start + key_idx;
+        
+        // Check if it's likely a JSON key (surrounded by quotes or followed by colon)
+        // For simplicity, we just look for the next colon.
+        if let Some(colon_idx) = s[absolute_key_idx..].find(':') {
+            let absolute_colon_idx = absolute_key_idx + colon_idx;
+            
+            // Now find where the value starts and ends.
+            // Values can be:
+            // 1. "..."
+            // 2. number
+            // 3. true/false/null
+            // 4. [REDACTED] (already redacted)
+            
+            let value_start_part = &s[absolute_colon_idx + 1..];
+            let first_non_ws = value_start_part.find(|c: char| !c.is_whitespace());
+            
+            if let Some(val_start_idx) = first_non_ws {
+                let absolute_val_start_idx = absolute_colon_idx + 1 + val_start_idx;
+                let val_first_char = s.as_bytes()[absolute_val_start_idx] as char;
+                
+                let (val_end_idx, is_quoted) = if val_first_char == '"' {
+                    // Quoted string. Find next unescaped quote.
+                    let mut end = absolute_val_start_idx + 1;
+                    let mut escaped = false;
+                    while end < s.len() {
+                        let c = s.as_bytes()[end] as char;
+                        if escaped {
+                            escaped = false;
+                        } else if c == '\\' {
+                            escaped = true;
+                        } else if c == '"' {
+                            break;
+                        }
+                        end += 1;
+                    }
+                    (end + 1, true)
+                } else {
+                    // Non-quoted value. Find next comma, brace, or end of string.
+                    let mut end = absolute_val_start_idx;
+                    while end < s.len() {
+                        let c = s.as_bytes()[end] as char;
+                        if c == ',' || c == '}' || c == ']' || c.is_whitespace() {
+                            break;
+                        }
+                        end += 1;
+                    }
+                    (end, false)
+                };
+
+                // Redact it if it's not already redacted.
+                let val_to_redact = &s[absolute_val_start_idx..val_end_idx];
+                if val_to_redact != "[REDACTED]" && val_to_redact != "\"[REDACTED]\"" {
+                    let replacement = if is_quoted { "\"[REDACTED]\"" } else { "[REDACTED]" };
+                    s.replace_range(absolute_val_start_idx..val_end_idx, replacement);
+                    start = absolute_val_start_idx + replacement.len();
+                } else {
+                    start = val_end_idx;
+                }
+            } else {
+                start = absolute_colon_idx + 1;
+            }
+        } else {
+            start = absolute_key_idx + key.len();
+        }
+        
+        if start >= s.len() {
+            break;
+        }
+    }
+}
+
+fn is_secret_key(key: &str) -> bool {
+    let k = key.to_lowercase();
+    k.contains("key") || k.contains("secret") || k.contains("token") || k.contains("password") || k.contains("auth") || k.contains("credential") || k.contains("apikey")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn test_redact_value() {
+        let mut v = json!({
+            "api_key": "sk-12345",
+            "normal": "value",
+            "nested": {
+                "secret_token": "abc",
+                "safe": 123
+            },
+            "array": [
+                {"password": "pw1"},
+                "safe"
+            ]
+        });
+        
+        redact_value(&mut v);
+        
+        assert_eq!(v["api_key"], "[REDACTED]");
+        assert_eq!(v["normal"], "value");
+        assert_eq!(v["nested"]["secret_token"], "[REDACTED]");
+        assert_eq!(v["nested"]["safe"], 123);
+        assert_eq!(v["array"][0]["password"], "[REDACTED]");
+        assert_eq!(v["array"][1], "safe");
+    }
+
+    #[test]
+    fn test_redact_message() {
+        let msg = "Error: invalid key 'secret_val' in {\"api_key\": \"sk-123\", \"other\": 123}";
+        let redacted = redact_message(msg);
+        assert!(redacted.contains("\"api_key\": \"[REDACTED]\""));
+        assert!(redacted.contains("\"other\": 123"));
+        
+        let msg2 = "failed with token:my-token and auth=true";
+        let redacted2 = redact_message(msg2);
+        assert!(redacted2.contains("token:[REDACTED]"));
+    }
+    
+    #[test]
+    fn test_redact_message_unquoted() {
+        let msg = "error at {\"key\": 12345}";
+        let redacted = redact_message(msg);
+        assert!(redacted.contains("\"key\": [REDACTED]"));
+    }
+}

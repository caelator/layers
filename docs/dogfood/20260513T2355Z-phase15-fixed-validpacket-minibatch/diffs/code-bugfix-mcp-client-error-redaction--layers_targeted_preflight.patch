+/// Redact secret-like fields in a string (e.g., error messages).
+///
+/// This looks for common secret-like keys in JSON-like structures and masks their values.
+#[must_use]
+pub fn redact_secrets(input: &str) -> String {
+    // Simple regex-based redaction for common secret-like patterns in JSON.
+    // Matches "key": "value" or "key": value
+    // Keywords: api_key, apikey, secret, token, password, auth, credential, access_key, private_key
+    let patterns = [
+        "api_key",
+        "apikey",
+        "secret",
+        "token",
+        "password",
+        "auth",
+        "credential",
+        "access_key",
+        "private_key",
+    ];
+
+    let mut redacted = input.to_string();
+
+    for key in patterns {
+        // 1. Redact quoted values: "key": "value"
+        let re_quoted = format!(r#"(?i)("{}")\s*:\s*"[^"]*""#, key);
+        if let Ok(re) = regex::Regex::new(&re_quoted) {
+            redacted = re.replace_all(&redacted, r#"$1: "[REDACTED]""#).to_string();
+        }
+
+        // 2. Redact unquoted values: "key": value (but not if it was already redacted to "[REDACTED]")
+        // We look for values that don't start with a quote and aren't null/true/false.
+        let re_unquoted = format!(r#"(?i)("{}")\s*:\s*([^"\s,\}}\]]+)"#, key);
+        if let Ok(re) = regex::Regex::new(&re_unquoted) {
+            redacted = re
+                .replace_all(&redacted, |caps: &regex::Captures| {
+                    let val = &caps[2];
+                    if val == "null" || val == "true" || val == "false" || val == "[REDACTED]" {
+                        caps[0].to_string()
+                    } else {
+                        format!("{}: [REDACTED]", &caps[1])
+                    }
+                })
+                .to_string();
+        }
+    }
+
+
+    redacted
+}

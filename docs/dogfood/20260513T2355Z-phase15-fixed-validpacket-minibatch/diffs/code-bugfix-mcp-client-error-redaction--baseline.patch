+//! Redaction utilities for sensitive fields.
+
+use serde_json::Value;
+
+/// Redact sensitive fields from a JSON value.
+pub fn redact_value(value: &mut Value) {
+    match value {
+        Value::Object(obj) => {
+            for (key, val) in obj.iter_mut() {
+                if is_sensitive_key(key) {
+                    *val = Value::String("[REDACTED]".to_string());
+                } else {
+                    redact_value(val);
+                }
+            }
+        }
+        Value::Array(arr) => {
+            for val in arr.iter_mut() {
+                redact_value(val);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Redact sensitive values from a string message.
+///
+/// This is a best-effort redaction that looks for patterns like
+/// `invalid type: string "secret", expected integer` and replaces the secret.
+pub fn redact_message(message: &str) -> String {
+    let mut redacted = message.to_string();
+
+    // Redact patterns if they seem to follow "invalid type" or similar serde patterns
+    if redacted.contains("invalid type") || redacted.contains("expected") || is_sensitive_message(&redacted) {
+        redacted = redact_quoted_values(&redacted);
+    }
+
+    redacted
+}
+
+fn is_sensitive_key(key: &str) -> bool {
+    let k = key.to_lowercase();
+    k.contains("key")
+        || k.contains("token")
+        || k.contains("secret")
+        || k.contains("password")
+        || k.contains("auth")
+        || k.contains("authorization")
+}
+
+fn is_sensitive_message(msg: &str) -> bool {
+    let m = msg.to_lowercase();
+    m.contains("key")
+        || m.contains("token")
+        || m.contains("secret")
+        || m.contains("password")
+        || m.contains("auth")
+}
+
+fn redact_quoted_values(msg: &str) -> String {
+    // Heuristic: replace values in quotes or backticks if the message looks like a type error
+    // e.g. 'invalid type: string "secret-value", expected i64'
+    // -> 'invalid type: string "[REDACTED]", expected i64'
+
+    let mut result = String::new();
+    let mut in_quotes = false;
+    let mut in_backticks = false;
+    let mut last_pos = 0;
+
+    let chars: Vec<char> = msg.chars().collect();
+    let mut i = 0;
+    while i < chars.len() {
+        if chars[i] == '"' && !in_backticks {
+            if in_quotes {
+                result.push_str("[REDACTED]\"");
+                in_quotes = false;
+            } else {
+                result.push_str(&msg[last_pos..i + 1]);
+                in_quotes = true;
+            }
+            last_pos = i + 1;
+        } else if chars[i] == '`' && !in_quotes {
+            if in_backticks {
+                result.push_str("[REDACTED]`");
+                in_backticks = false;
+            } else {
+                result.push_str(&msg[last_pos..i + 1]);
+                in_backticks = true;
+            }
+            last_pos = i + 1;
+        }
+        if !in_quotes && !in_backticks {
+            // we will catch up in the next push_str
+        }
+        i += 1;
+    }
+    result.push_str(&msg[last_pos..]);
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn test_redact_value() {
+        let mut v = json!({
+            "api_key": "secret",
+            "nested": {
+                "token": "more-secret",
+                "safe": "data"
+            },
+            "array": [
+                {"password": "pw"},
+                "safe"
+            ]
+        });
+        redact_value(&mut v);
+        assert_eq!(v["api_key"], "[REDACTED]");
+        assert_eq!(v["nested"]["token"], "[REDACTED]");
+        assert_eq!(v["nested"]["safe"], "data");
+        assert_eq!(v["array"][0]["password"], "[REDACTED]");
+        assert_eq!(v["array"][1], "safe");
+    }
+
+    #[test]
+    fn test_serde_from_value_error() {
+        let v = json!({"api_key": 123});
+        #[derive(serde::Deserialize)]
+        struct Req {
+            #[allow(dead_code)]
+            api_key: String,
+        }
+        let res: Result<Req, _> = serde_json::from_value(v);
+        if let Err(e) = res {
+            let msg = e.to_string();
+            println!("from_value error: {}", msg);
+            // It might be "invalid type: integer `123`, expected a string"
+            // If it doesn't mention "api_key", my current redact_message won't catch it!
+        }
+    }
+
+    #[test]
+    fn test_redact_message() {
+        let msg2 = "invalid type: string \"secret-value\", expected i64 for key api_key";
+        let redacted = redact_message(msg2);
+        assert!(redacted.contains("[REDACTED]"));
+        assert!(!redacted.contains("secret-value"));
+
+        let msg3 = "invalid type: integer `123`, expected a string for token";
+        let redacted3 = redact_message(msg3);
+        assert!(redacted3.contains("[REDACTED]"));
+        assert!(!redacted3.contains("123"));
+    }
+}

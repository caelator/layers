+    #[tokio::test]
+    async fn test_stable_tool_redaction() {
+        let registry = crate::stable::stable_context_registry();
+        let tool = registry.get("context_compile").unwrap();
+
+        // Provide invalid type for a field
+        let args = serde_json::json!({
+            "task": "test",
+            "max_units": "not-an-integer"
+        });
+
+        let context = ToolContext {
+            session_id: "test".to_string(),
+            agent_id: "test".to_string(),
+            channel: None,
+            metadata: std::collections::HashMap::new(),
+        };
+
+        let result = tool.execute(args, context).await;
+        assert!(result.is_err());
+        let err_msg = result.unwrap_err().to_string();
+
+        // The error message from context_compile tool should be redacted
+        assert!(err_msg.contains("[REDACTED]"));
+        assert!(!err_msg.contains("not-an-integer"));
+    }
 }

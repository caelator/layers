        } => {
            let corpus = load_retrieval_eval_corpus(path)?;
            let report = evaluate_embedding_retrieval(
                &corpus,
                &OpenAiEmbeddingClient,
                &EmbeddingRetrievalConfig {
                    endpoint: endpoint.clone(),
                    model: model.clone(),
                    batch_size: *batch_size,
                },
            )?;

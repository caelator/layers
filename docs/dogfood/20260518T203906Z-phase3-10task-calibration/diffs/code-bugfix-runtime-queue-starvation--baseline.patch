+
+    #[test]
+    fn no_starvation_beyond_ratio_when_stealing() {
+        let q = WeightedFairQueue::new(100);
+
+        // 1. Move round_position to 8 (standard turn)
+        for _ in 0..8 {
+            q.enqueue(TaskItem::new("c", true));
+            q.try_dequeue().unwrap();
+        }
+
+        // 2. Standard is empty, so critical steals the turn.
+        q.enqueue(TaskItem::new("c_stolen", true));
+        let (item, _) = q.try_dequeue().unwrap();
+        assert_eq!(item.id, "c_stolen");
+        // With fix: round_position stays 8!
+
+        // 3. A standard item arrives.
+        q.enqueue(TaskItem::new("s_victim", false));
+
+        // 4. Critical items keep arriving.
+        for i in 0..100 {
+            q.enqueue(TaskItem::new(format!("c_heavy_{}", i), true));
+        }
+
+        // 5. Dequeue. Standard should be served IMMEDIATELY because it's still
+        // turn 8.  In the buggy version, it had to wait for 8 more criticals.
+        let (item, _) = q.try_dequeue().unwrap();
+        assert!(!item.critical_path);
+        assert_eq!(item.id, "s_victim");
+    }
+
+    #[test]
+    fn re_enqueue_at_front_preserves_order() {
+        let q = WeightedFairQueue::new(64);
+        q.enqueue(TaskItem::new("s1", false));
+        q.enqueue(TaskItem::new("s2", false));
+
+        let (item, _) = q.try_dequeue().unwrap();
+        assert_eq!(item.id, "s1");
+
+        // Re-enqueue s1 at front.
+        q.re_enqueue(item);
+
+        let (item, _) = q.try_dequeue().unwrap();
+        assert_eq!(item.id, "s1", "s1 should still be at the front");
+    }

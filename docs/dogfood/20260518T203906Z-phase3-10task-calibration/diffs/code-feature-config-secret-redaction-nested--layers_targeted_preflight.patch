+    #[test]
+    fn mask_secrets_redacts_nested_extra_keys() {
+        let mut config = LayersConfig::default();
+        let mut extra = std::collections::HashMap::new();
+        extra.insert(
+            "deep_secret".to_string(),
+            toml::Value::String("very-secret-value-long-enough".to_string()),
+        );
+        let mut nested_table = toml::value::Table::new();
+        nested_table.insert(
+            "api_token".to_string(),
+            toml::Value::String("nested-token-value-long-enough".to_string()),
+        );
+        extra.insert("nested".to_string(), toml::Value::Table(nested_table));
+
+        let provider = layers_core::config::ProviderConfig {
+            api_key: None,
+            api_base: None,
+            models: vec![],
+            extra,
+        };
+        config.providers.insert("custom".to_string(), provider);
+
+        let masked = mask_secrets(&config);
+        let p = masked.providers.get("custom").unwrap();
+        
+        let deep_secret = p.extra.get("deep_secret").unwrap().as_str().unwrap();
+        assert!(deep_secret.contains("****"));
+        assert!(!deep_secret.contains("very-secret"));
+
+        let nested = p.extra.get("nested").unwrap().as_table().unwrap();
+        let api_token = nested.get("api_token").unwrap().as_str().unwrap();
+        assert!(api_token.contains("****"));
+        assert!(!api_token.contains("nested-token"));
+    }

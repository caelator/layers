+fn is_secret_key(key: &str) -> bool {
+    let k = key.to_lowercase();
+    k.contains("key")
+        || k.contains("token")
+        || k.contains("secret")
+        || k.contains("password")
+        || k.contains("credential")
+        || k.contains("auth")
+}
+
+fn mask_toml_value(value: &mut toml::Value, is_secret: bool) {
+    match value {
+        toml::Value::String(s) => {
+            if is_secret {
+                *s = mask_secret(s);
+            }
+        }
+        toml::Value::Array(arr) => {
+            for v in arr {
+                mask_toml_value(v, is_secret);
+            }
+        }
+        toml::Value::Table(table) => {
+            for (k, v) in table.iter_mut() {
+                let secret = is_secret || is_secret_key(k);
+                mask_toml_value(v, secret);
+            }
+        }
+        _ => {}
+    }
+}

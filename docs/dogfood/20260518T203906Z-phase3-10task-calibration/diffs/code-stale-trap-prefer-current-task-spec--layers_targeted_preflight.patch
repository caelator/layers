+fn validate_task_id_format(id: &str) -> bool {
+    if id.is_empty() {
+        return false;
+    }
+    let first = id.chars().next().unwrap();
+    if !first.is_ascii_lowercase() && !first.is_ascii_digit() {
+        return false;
+    }
+    id.chars()
+        .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-' || c == '_')
+}

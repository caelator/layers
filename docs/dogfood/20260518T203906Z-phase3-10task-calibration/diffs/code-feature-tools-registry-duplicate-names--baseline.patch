         Self::new()
     }
 }
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use layers_core::{Tool, ToolContext, ToolOutput};
+    use std::sync::Arc;
+
+    struct MockTool(&'static str);
+
+    #[async_trait::async_trait]
+    impl Tool for MockTool {
+        fn name(&self) -> &str {
+            self.0
+        }
+        fn description(&self) -> &str {
+            "mock"
+        }
+        fn schema(&self) -> serde_json::Value {
+            serde_json::json!({})
+        }
+        async fn execute(&self, _args: serde_json::Value, _ctx: ToolContext) -> Result<ToolOutput> {
+            Ok(ToolOutput::text("ok"))
+        }
+    }
+
+    #[test]
+    fn register_unique() {
+        let mut reg = ToolRegistry::new();
+        reg.register(Arc::new(MockTool("t1"))).unwrap();
+        reg.register(Arc::new(MockTool("t2"))).unwrap();
+        assert_eq!(reg.total_count(), 2);
+    }
+
+    #[test]
+    fn register_duplicate_fails() {
+        let mut reg = ToolRegistry::new();
+        reg.register(Arc::new(MockTool("t1"))).unwrap();
+        let result = reg.register(Arc::new(MockTool("t1")));
+        assert!(result.is_err());
+        assert!(result.unwrap_err().to_string().contains("duplicate"));
+    }
+}

+// ---------------------------------------------------------------------------
+// Redaction utilities
+// ---------------------------------------------------------------------------
+
+/// Returns true if the given key name suggests it contains sensitive information.
+pub fn is_sensitive_key(key: &str) -> bool {
+    let k = key.to_lowercase();
+    k.contains("key")
+        || k.contains("token")
+        || k.contains("secret")
+        || k.contains("auth")
+        || k.contains("password")
+        || k.contains("credential")
+        || k.contains("api")
+}
+
+/// Recursively collects all values associated with sensitive keys in a JSON object.
+pub fn collect_secrets(value: &serde_json::Value) -> Vec<String> {
+    let mut secrets = Vec::new();
+    match value {
+        serde_json::Value::Object(obj) => {
+            for (key, val) in obj {
+                if is_sensitive_key(key) {
+                    match val {
+                        serde_json::Value::String(s) => {
+                            if !s.is_empty() {
+                                secrets.push(s.clone());
+                            }
+                        }
+                        serde_json::Value::Number(n) => {
+                            secrets.push(n.to_string());
+                        }
+                        _ => {
+                            // For other types, we might not want to redact literal match
+                            // unless it's a string, but let's be safe.
+                            let s = val.to_string();
+                            if s != "null" && s != "{}" && s != "[]" {
+                                secrets.push(s);
+                            }
+                        }
+                    }
+                } else {
+                    secrets.extend(collect_secrets(val));
+                }
+            }
+        }
+        serde_json::Value::Array(arr) => {
+            for val in arr {
+                secrets.extend(collect_secrets(val));
+            }
+        }
+        _ => {}
+    }
+    secrets
+}
+
+/// Redacts known secrets from the given message string based on a request payload.
+pub fn redact_secrets_with_context(message: &str, context: &serde_json::Value) -> String {
+    let secrets = collect_secrets(context);
+    let mut redacted = message.to_string();
+    
+    // Sort secrets by length descending to avoid partial redaction of longer secrets
+    // if a shorter secret is a prefix.
+    let mut sorted_secrets = secrets;
+    sorted_secrets.sort_by(|a, b| b.len().cmp(&a.len()));
+    
+    for secret in sorted_secrets {
+        // Only redact if the secret is long enough to be meaningful and not likely a false positive
+        if secret.len() >= 3 {
+            redacted = redacted.replace(&secret, "[REDACTED]");
+        }
+    }
+    redacted
+}
+

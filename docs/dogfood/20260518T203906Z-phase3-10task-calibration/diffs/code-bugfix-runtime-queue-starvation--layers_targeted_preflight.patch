+    #[test]
+    fn test_no_wasted_turn_when_busy() {
+        // Prove that calling acquire() when all slots are full DOES NOT
+        // advance the round-robin counter, preserving fairness.
+        let d = Dispatcher::new(DispatcherConfig {
+            total_workers: 1,
+            reserved_critical_slots: 0,
+            critical_queue_capacity: 10,
+        });
+
+        // 1. Fill the only slot.
+        d.submit(TaskItem::new("c1", true));
+        d.acquire().expect("should acquire c1");
+
+        // 2. Queue up a standard item. Round position is at 1.
+        // We want to reach position 8 (standard turn).
+        for i in 0..7 {
+            d.submit(TaskItem::new(format!("c_fill_{i}"), true));
+        }
+        d.submit(TaskItem::new("s_victim", false));
+
+        // 3. Call acquire 100 times while busy.
+        // With the bug, this would advance the round many times.
+        // Fixed: round position stays at 1.
+        for _ in 0..100 {
+            assert!(d.acquire().is_none());
+        }
+
+        // 4. Release the slot.
+        d.release(true);
+
+        // 5. Dequeue enough critical items to reach the standard turn.
+        // Since we are at pos 1, we need 7 more critical dequeues to reach pos 8.
+        for _ in 0..7 {
+            let (item, _) = d.acquire().unwrap();
+            assert!(item.critical_path, "should be critical at pos 1..7");
+            d.release(true);
+        }
+
+        // 6. The NEXT dequeue MUST be standard (pos 8).
+        let (item, _) = d.acquire().expect("should acquire s_victim");
+        assert!(!item.critical_path, "should be standard at pos 8");
+        assert_eq!(item.id, "s_victim");
+    }
+

new file mode 100644
index 0000000..06de53e
--- /dev/null
+++ b/crates/layers-mcp/src/util.rs
@@ -0,0 +1,128 @@
+use serde_json::Value;
+
+/// Redact secret-like fields from a JSON value recursively.
+pub fn redact_value(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            for (key, val) in map.iter_mut() {
+                if is_secret_field(key) {
+                    *val = Value::String("[REDACTED]".to_string());
+                } else {
+                    redact_value(val);
+                }
+            }
+        }
+        Value::Array(arr) => {
+            for val in arr.iter_mut() {
+                redact_value(val);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Returns true if the field name suggests it contains sensitive information.
+pub fn is_secret_field(name: &str) -> bool {
+    let lower = name.to_lowercase();
+    lower.contains("key")
+        || lower.contains("token")
+        || lower.contains("password")
+        || lower.contains("secret")
+        || lower.contains("auth")
+        || lower.contains("credential")
+}
+
+/// Redact secret-like values from an error message string.
+pub fn redact_error_message(message: &str) -> String {
+    let mut result = message.to_string();
+    let secret_keywords = ["key", "token", "password", "secret", "auth", "credential"];
+    
+    for kw in secret_keywords {
+        let mut start_search = 0;
+        while let Some(pos) = result[start_search..].to_lowercase().find(kw) {
+            let kw_pos = start_search + pos;
+            let after_kw = &result[kw_pos + kw.len()..];
+            
+            // Look for a separator (: or =) within a few characters
+            if let Some(sep_pos) = after_kw.find(|c: char| c == ':' || c == '=') {
+                if sep_pos < 10 { // Heuristic: separator should be close to the keyword
+                    let sep_idx = kw_pos + kw.len() + sep_pos;
+                    let val_start_idx = sep_idx + 1;
+                    let val_part = &result[val_start_idx..];
+                    let trimmed_val = val_part.trim_start();
+                    let val_offset = val_part.len() - trimmed_val.len();
+                    let actual_val_start = val_start_idx + val_offset;
+                    
+                    if trimmed_val.starts_with('"') {
+                        // Quoted value
+                        if let Some(end_quote) = trimmed_val[1..].find('"') {
+                            let replacement = "\"[REDACTED]\"";
+                            result.replace_range(actual_val_start..actual_val_start + end_quote + 2, replacement);
+                            start_search = actual_val_start + replacement.len();
+                            continue;
+                        }
+                    } else {
+                        // Unquoted value - find end (space, comma, brace, etc.)
+                        let end_val = trimmed_val.find(|c: char| c == ',' || c == '}' || c == ' ' || c == '\n' || c == ']' || c == ')')
+                            .unwrap_or(trimmed_val.len());
+                        
+                        if end_val > 0 {
+                            let replacement = "[REDACTED]";
+                            result.replace_range(actual_val_start..actual_val_start + end_val, replacement);
+                            start_search = actual_val_start + replacement.len();
+                            continue;
+                        }
+                    }
+                }
+            }
+            start_search = kw_pos + kw.len();
+        }
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn test_redact_value() {
+        let mut v = json!({
+            "api_key": "secret123",
+            "user": "bob",
+            "nested": {
+                "token": "abc",
+                "safe": 123
+            },
+            "array": [{"password": "pwd"}, "safe"]
+        });
+        redact_value(&mut v);
+        assert_eq!(v["api_key"], "[REDACTED]");
+        assert_eq!(v["user"], "bob");
+        assert_eq!(v["nested"]["token"], "[REDACTED]");
+        assert_eq!(v["nested"]["safe"], 123);
+        assert_eq!(v["array"][0]["password"], "[REDACTED]");
+        assert_eq!(v["array"][1], "safe");
+    }
+
+    #[test]
+    fn test_redact_error_message() {
+        assert_eq!(
+            redact_error_message("invalid api_key: \"secret123\" for user"),
+            "invalid api_key: \"[REDACTED]\" for user"
+        );
+        assert_eq!(
+            redact_error_message("error: password=mypassword, please retry"),
+            "error: password=[REDACTED], please retry"
+        );
+        assert_eq!(
+            redact_error_message("failed with token: abc-123"),
+            "failed with token: [REDACTED]"
+        );
+        assert_eq!(
+            redact_error_message("nested: {\"secret\":\"val\"}"),
+            "nested: {\"secret\":\"[REDACTED]\"}"
+        );
+    }
+}

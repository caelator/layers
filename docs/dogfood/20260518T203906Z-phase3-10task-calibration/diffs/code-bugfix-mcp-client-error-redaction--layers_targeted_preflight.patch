+    async fn error_redaction_end_to_end() {
+        let registry = make_registry();
+        let config = McpServerConfig {
+            allowlisted_tools: vec!["read_config".to_string()],
+            ..Default::default()
+        };
+        let server = McpServer::new(registry, config);
+
+        // 1. Parse error with sensitive info
+        let request = r#"{"jsonrpc": "2.0", "method": "tools/call", "params": {"api_key": "secret123"}, "invalid"}"#;
+        // In the real run loop, this would be caught. We'll simulate handle_request if it was valid JSON but failed elsewhere,
+        // but for parse error we test the logic in run() loop (simulated here).
+        let e = serde_json::from_str::<serde_json::Value>(request).unwrap_err();
+        let mut err = JsonRpcError {
+            code: -32700,
+            message: format!("Parse error: {e}"),
+            data: None,
+        };
+        err.redact();
+        // serde_json errors don't usually leak values, but if they did, redact() would catch it.
+        // Let's test a more direct leak in message.
+        err.message = "Invalid token: 'my-secret-token'".to_string();
+        err.redact();
+        assert!(err.message.contains("[REDACTED]"));
+        assert!(!err.message.contains("my-secret-token"));
+
+        // 2. Tool call with secret-like arguments that fails
+        let params = serde_json::json!({
+            "name": "non_existent_tool",
+            "arguments": { "password": "password123" }
+        });
+        let req = JsonRpcRequest {
+            jsonrpc: "2.0".to_string(),
+            id: Some(serde_json::json!(1)),
+            method: "tools/call".to_string(),
+            params: Some(params),
+        };
+        let resp = server.handle_request(&req).await;
+        let err = resp.error.unwrap();
+        assert!(err.message.contains("[REDACTED]") || !err.message.contains("password123"));
+    }
 }

 }
 
+impl JsonRpcError {
+    /// Redact sensitive information from the error message and data.
+    pub fn redact(&mut self) {
+        self.message = crate::util::redact_error_message(&self.message);
+        if let Some(ref mut data) = self.data {
+            crate::util::redact_value(data);
+        }
+    }
+}
